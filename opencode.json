{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": { "*": "allow" },
    "external_directory": { "*": "allow" },
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "git push*": "deny",
      "curl * | sh": "deny",
      "curl * | bash": "deny"
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Cloud",
      "options": {
        "baseURL": "https://ollama.com/v1",
        "apiKey": "{env:OLLAMA_API_KEY}"
      },
      "models": {
        "minimax-m3": { "name": "MiniMax M3" }
      }
    }
  }
}
