# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_your_key_here
LANGSMITH_PROJECT=multi-agent-research
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Ollama model
# Option A — local daemon proxying to cloud (recommended; pair with `ollama run <model>-cloud`):
#   leave OLLAMA_BASE_URL and OLLAMA_API_KEY unset and use a -cloud suffix:
OLLAMA_MODEL=gpt-oss:120b-cloud
# Option B — hit ollama.com directly:
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_API_KEY=your_ollama_cloud_api_key
# OLLAMA_MODEL=gpt-oss:120b

# Max concurrent judge-research ReAct loops hitting Ollama. Lower if you see
# 'too many concurrent requests' from the backend.
JUDGE_RESEARCH_CONCURRENCY=2

# Max concurrent idea-research ReAct loops hitting Ollama. Same throttle as
# above but for the app-idea research fan-out (up to 20 ideas). Lower if you see
# 'too many concurrent requests' from the backend.
IDEA_RESEARCH_CONCURRENCY=2

# Model used by the opencode coding sub-agents in the build phase, as
# provider/model. The `ollama` provider is defined in opencode.json and reuses
# OLLAMA_API_KEY above.
BUILD_MODEL=ollama/minimax-m3

# Per-task wall-clock limit (seconds) for one coding sub-agent before it is
# killed and the build stops.
BUILD_TASK_TIMEOUT=900

# Attempts for each model call before giving up, on transient network failures
# (Ollama Cloud drops connections mid-response as httpx.ReadError).
MODEL_RETRIES=3

# Supersteps a research ReAct agent may take before LangGraph aborts it
# (default 25 is about a dozen tool calls, which real research can exceed).
RESEARCH_RECURSION_LIMIT=40

# Seconds a single research worker may run before it is abandoned and that one
# judge/idea degrades. Guards against a hung request, which retries cannot see.
RESEARCH_TIMEOUT=300
